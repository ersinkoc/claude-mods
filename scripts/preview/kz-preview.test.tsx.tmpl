  // Tool results, by tool; one stays in flight until the drawings are taken.
  let release: () => void = () => undefined
  const held = new Promise<void>(r => (release = r))
  on('tool.call', async ($, e) => {
    const x = e as unknown as Record<string, unknown>
    if (x.command === 'npm run test:e2e') await held
    if (x.command === 'npm test') return { isError: true, result: { stdout: 'Tests: 3 failed, 139 passed, 142 total', stderr: 'FAIL src/ui/band.test.tsx', interrupted: false }, text: 'Exit code 1\nTests: 3 failed, 139 passed, 142 total' } as never
    if (e.tool === 'Bash') return { result: { stdout: 'ok', stderr: '', interrupted: false } } as never
    if (e.tool === 'WebFetch') return { result: { bytes: 48_211, code: 200, codeText: 'OK', result: 'ok', durationMs: 900, url: x.url } } as never
    if (e.tool === 'TaskCreate') return { result: { task: { id: String(Math.floor(Math.random() * 1000)), subject: x.subject } } } as never
    return { result: { ok: true } } as never
  })
  on('turn.step', async function* ($, e) {
    const out = e.agentId ? 2_400 : 3_800
    return { turnId: e.turnId, index: e.index, answer: '', toolUses: [], stopReason: 'tool_use', usage: { model: e.model, input_tokens: 2_100, output_tokens: out, cache_read_input_tokens: 48_000, cache_creation_input_tokens: 3_200 } } as never
  })
  on('turn.start', ($, e) => ({ turnId: e.turnId }))
  on('turn.complete', ($, e) => ({ text: e.answer, usage: e.usage }))
  on('prompt.submit', ($, e) => ({ text: e.text }) as never)
  // What the engine itself would draw at each site, beneath the mod.
  on('ui.render', ($, e) => {
    const { Text } = $.ui.resolve(e as never) as never as { Text: (p: Record<string, unknown>) => never }
    const p = (e as unknown as { props: Record<string, unknown> }).props ?? {}
    switch ((e as unknown as { component: string }).component) {
      case 'Spinner': return Text({ color: '#d77757', children: `✻ ${String(p.word ?? 'Thinking')}…${String(p.suffix ?? '')}${p.message ? ' ' + String(p.message) : ''}` })
      case 'TurnDuration': return Text({ dimColor: true, children: `✻ ${String(p.word ?? 'Cooked')} for ${Math.round(Number(p.durationMs ?? 0) / 1000)}s` })
      case 'PromptHint': return Text({ dimColor: true, children: `${String(p.hint ?? '')}${p.tail ? '  ' + String(p.tail) : ''}` })
      default: return Text({ children: '' })
    }
  })

  const step = async (fn: () => Promise<unknown>) => {
    try {
      await fn()
    } catch {
      // A mod that refuses a step of the made-up session still gets drawn.
    }
  }
  const tick = (ms: number) => step(() => clock.advance(ms))
  const call = (input: Record<string, unknown>, agentId?: string) => step(() => $.tool.call({ ...(input as never), ...(agentId ? { agentId } : {}) }))
  const stepOf = (turnId: string, index: number, agentId?: string, model = 'claude-opus-5-5') =>
    step(async () => {
      const s = $.turn.step({ turnId, index, model, effort: 'xhigh', messageCount: 12 + index, ...(agentId ? { agentId } : {}) } as never) as unknown as AsyncIterable<unknown>
      for await (const _ of s) void _
    })

  await step(() => $.session.start({ surface: 'terminal', isInteractive: true, cwd: 'C:/work/kozmos' } as never))

  // Turn 1, finished.
  await step(() => $.prompt.submit({ text: 'Map the band composer and list what breaks when two mods draw', wait: false, origin: { kind: 'composer' } } as never))
  await step(() => $.turn.start({ text: 'Map the band composer', turnId: 't1' }))
  await stepOf('t1', 0)
  await call({ tool: 'Grep', tool_use_id: 'u1', pattern: 'AbovePrompt', path: 'src' }); await tick(1_200)
  await call({ tool: 'Read', tool_use_id: 'u2', file_path: 'C:/work/kozmos/src/ui/band.tsx' }); await tick(800)
  await call({ tool: 'Read', tool_use_id: 'u3', file_path: 'C:/work/kozmos/src/engine/orbit.ts' }); await tick(700)
  await call({ tool: 'WebFetch', tool_use_id: 'u4', url: 'https://code.claude.com/docs/en/plugins', prompt: 'hooks' }); await tick(2_100)
  await stepOf('t1', 1)
  usageK = 2
  await step(() => $.turn.complete({ answer: 'Two bands overwrite each other unless each composes next(e).', durationMs: 38_000, isAborted: false, turnId: 't1', reason: 'answer', usage: { model: 'claude-opus-5-5', input_tokens: 4_200, output_tokens: 7_600, cache_read_input_tokens: 96_000, cache_creation_input_tokens: 6_400 } } as never))
  await tick(20_000)

  // Turn 2, in flight: tasks, edits, a failed test run, three subagents, a test run still going.
  await step(() => $.prompt.submit({ text: 'Build the orbit engine and make every band compose', wait: false, origin: { kind: 'composer' } } as never))
  await step(() => $.turn.start({ text: 'Build the orbit engine', turnId: 't2' }))
  await stepOf('t2', 0)
  await call({ tool: 'TodoWrite', tool_use_id: 'u5', todos: [
    { content: 'Sketch the orbit math', status: 'completed', activeForm: 'Sketching the orbit math' },
    { content: 'Write the orbit engine', status: 'completed', activeForm: 'Writing the orbit engine' },
    { content: 'Make bands compose', status: 'completed', activeForm: 'Making bands compose' },
    { content: 'Run the test suite', status: 'in_progress', activeForm: 'Running the test suite' },
    { content: 'Polish the desktop SVG', status: 'pending', activeForm: 'Polishing the desktop SVG' },
    { content: 'Write the README', status: 'pending', activeForm: 'Writing the README' },
  ] })
  await tick(1_500)
  await call({ tool: 'Edit', tool_use_id: 'u6', file_path: 'C:/work/kozmos/src/engine/orbit.ts', old_string: 'a\nb', new_string: 'a\nb\nc\nd\ne' }); await tick(900)
  await call({ tool: 'Write', tool_use_id: 'u7', file_path: 'C:/work/kozmos/src/engine/warp.ts', content: 'export const warp = 1\n'.repeat(40) }); await tick(700)
  await call({ tool: 'Edit', tool_use_id: 'u8', file_path: 'C:/work/kozmos/src/ui/band.tsx', old_string: 'x', new_string: 'y\nz' }); await tick(600)
  await call({ tool: 'Bash', tool_use_id: 'u9', command: 'npm test', description: 'Run the unit tests' }); await tick(14_000)
  await call({ tool: 'Bash', tool_use_id: 'u10', command: 'git commit -m "Orbit engine"', description: 'Commit the orbit engine' }); await tick(1_100)
  await stepOf('t2', 1)
  const spawn = (description: string, subagentType: string, model: string) =>
