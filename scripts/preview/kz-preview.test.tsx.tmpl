function propsOf(component: string, surface: string): Record<string, unknown> {
  const scroll = { offset: 0, bodyRows: 44 }
  const cols = surface === 'terminal' ? 50 : 54
  switch (component) {
    case 'Pane': return { title: MOD, isFocused: false, bodyColumns: cols, placement: 'dock', scroll, view: {} }
    case 'AbovePrompt': return { hasSurvey: false, isWorking: true, maxRows: 14, bodyColumns: 104, scroll, view: {} }
    case 'Spinner': return { word: 'Thinking', message: null, suffix: '', mode: 'thinking' }
    case 'TurnDuration': return { word: 'Cooked', durationMs: 42_600 }
    case 'PromptHint': return { isDraft: false, isWorking: true, hint: '? for shortcuts' }
    case 'SessionMode': return { modes: ['auto'] }
    default: return {}
  }
}

type Node = { type?: string; props?: Record<string, unknown>; children?: unknown }

