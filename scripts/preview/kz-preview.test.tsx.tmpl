  await spawn('Audit band composition', 'Explore', 'claude-sonnet-5-5')
  await spawn('Port gauges to SVG', 'general-purpose', 'claude-opus-5-5')
  await spawn('Write orbit tests', 'general-purpose', 'claude-haiku-5-5')
  for (const [i, a] of agents.entries()) {
    await stepOf(`ta${i}`, 0, a.id, i === 2 ? 'claude-haiku-5-5' : i === 0 ? 'claude-sonnet-5-5' : 'claude-opus-5-5')
    await call({ tool: i === 0 ? 'Grep' : 'Read', tool_use_id: `ua${i}`, pattern: 'next(e)', file_path: 'C:/work/kozmos/src/ui/pane.tsx' }, a.id)
    await stepOf(`ta${i}`, 1, a.id)
