  on('command.list', quiet(['bridge', 'kozmos', 'hivemind', 'orrery', 'heartline', 'halo', 'questline', 'marquee', 'hourglass', 'tokenomics', 'gitscope', 'vitals', 'clawdling', 'laurels', 'warden', 'stamp', 'compass', 'review', 'compact'].map(name => ({ name, description: name, source: 'plugin' })) as never))
