  const done = agents[2]
  if (done) {
    done.status = 'completed'
    await step(() => $.turn.complete({ answer: '12 tests written.', durationMs: 61_000, isAborted: false, turnId: 'ta2', agentId: done.id, reason: 'answer', usage: { model: 'claude-haiku-5-5', input_tokens: 3_000, output_tokens: 4_800, cache_read_input_tokens: 40_000, cache_creation_input_tokens: 2_000 } } as never))
  }
  usageK = 6
  await tick(4_000)
  void call({ tool: 'Bash', tool_use_id: 'u11', command: 'npm run test:e2e', description: 'Run the end-to-end tests' })
  await tick(9_000)

  // Draw. Small sites first: some bands read what the spinner shows.
  const order = ['Spinner', 'PromptHint', 'TurnDuration', 'SessionMode', 'AbovePrompt', 'Pane']
  const sites = [...SITES].sort((a, b) => order.indexOf(a.component) - order.indexOf(b.component))
  for (const surface of ['terminal', 'desktop'] as const) {
    for (const site of sites) {
      try {
        const ui = await $.ui.mount({
          plugin: MOD, surface, component: site.component as never, props: propsOf(site.component, surface) as never,
          ...(site.requestId ? { requestId: site.requestId } : {}),
          viewport: { columns: site.component === 'Pane' ? 52 : 108, rows: 44, isFullscreen: true } as never,
        })
        let tree = (await ui.drawn()) as unknown as Node
        // A Client draws in the surface: put its frame (after some animation) in its place.
        const clients: string[] = []
        const sizes: Record<string, { columns: number; rows: number }> = {}
        const span = (v: unknown, whole: number) => (typeof v === 'number' ? v : typeof v === 'string' && v.endsWith('%') ? Math.round((parseFloat(v) / 100) * whole) : undefined)
        const walk = (n: unknown): void => {
          if (!n || typeof n !== 'object') return
          const node = n as Node
          if (node.type === 'Client' && typeof node.props?.key === 'string') {
            clients.push(node.props.key)
            const p = node.props
            sizes[node.props.key] = { columns: span(p.width, 104) ?? 104, rows: span(p.height, 6) ?? 3 }
          }
          const kids = node.children
          if (Array.isArray(kids)) kids.forEach(walk)
          else walk(kids)
        }
        walk(tree)
        if (clients.length) {
          for (const key of clients) await ui.resize({ in: key, ...(sizes[key] ?? { columns: 104, rows: 3 }) }).catch(() => undefined)
          await ui.advance(2_400).catch(() => undefined)
          const frames: Record<string, unknown> = {}
          for (const key of clients) frames[key] = await ui.drawn({ in: key }).catch(() => null)
          const swap = (n: unknown): unknown => {
            if (Array.isArray(n)) return n.map(swap)
            if (!n || typeof n !== 'object') return n
            const node = n as Node
            if (node.type === 'Client' && typeof node.props?.key === 'string') return { type: 'ClientFrame', props: node.props, children: frames[node.props.key] ?? null }
            return { ...node, children: swap(node.children) }
          }
          tree = (await ui.drawn()) as unknown as Node
          tree = swap(tree) as Node
        }
        console.log('KZPREVIEW ' + JSON.stringify({ mod: MOD, component: site.component, requestId: site.requestId, surface, tree }))
        await ui.unmount()
      } catch (err) {
        console.log('KZPREVIEW ' + JSON.stringify({ mod: MOD, component: site.component, requestId: site.requestId, surface, error: String(err).slice(0, 300) }))
      }
    }
  }
